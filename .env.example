# GEMINI_API_KEY: Legacy Node-era configuration.
# The Java backend uses a deterministic in-process analytics engine
# (no external LLM), so this key is not required by the current stack.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Java backend base URL for the React frontend (Phase 8 integration).
# Leave empty to call same-origin relative /api/v1 paths (reverse-proxy
# deployments). For direct dev-server access to the Java backend:
VITE_JAVA_API_BASE_URL="http://localhost:8080"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Authentication
JWT_SECRET="MY_JWT_SECRET"
REFRESH_TOKEN_SECRET="MY_REFRESH_TOKEN_SECRET"

# PostgreSQL runtime configuration (TASK-004A-PREP)
# Leave blank until a disposable database target has been verified.
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Evidence Storage Configuration (local or supabase)
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="evidence-vault"

