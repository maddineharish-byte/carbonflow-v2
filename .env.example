# ---------------------------------------------------------------------------
# CarbonFlow environment template (Java-only production stack)
#
# Phase 10.5 removed the Node/Express backend. These are the variables the
# Java 21 / Spring Boot backend (`backend-java/`) actually reads, plus the one
# Vite variable the React frontend reads.
#
# Never commit a populated copy of this file. Copy to `.env`, fill in, and keep
# it out of version control (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Java backend: authentication ------------------------------------------
# Both secrets must be at least 32 random bytes. The application refuses to
# start if either is missing, blank, or too short (fail-closed).
CARBONFLOW_JWT_SECRET=
CARBONFLOW_REFRESH_TOKEN_SECRET=

# --- Java backend: database -----------------------------------------------
# The Java backend is the sole runtime and connects with JDBC. There is no
# DATABASE_URL; the host/port/name triple is used directly.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbonflow_dev
DB_USER=
DB_PASSWORD=

# PostgreSQL transport security. One of the PgJDBC sslmode values:
#   disable | allow | prefer | require | verify-ca | verify-full
# An unrecognised value fails application startup rather than silently
# downgrading. "require" encrypts the connection but does NOT verify the
# server certificate; "verify-ca" / "verify-full" verify against the JVM trust
# store (-Djavax.net.ssl.trustStore). The default "prefer" attempts TLS but
# falls back to plaintext, so set this explicitly in production.
# See docs/DEPLOYMENT-SECURITY.md.
DB_SSLMODE=prefer

# --- Java backend: browser CORS allow-list ---------------------------------
# Fail-closed. Leave empty in production: an empty value trusts NO browser
# origin. Set an explicit comma-separated list of exact origins, e.g.
# https://app.example.com. Wildcard `*` is refused at startup.
CARBONFLOW_CORS_ALLOWED_ORIGINS=

# --- Java backend: demo seeding --------------------------------------------
# Defaults to false. Enable only for local development; it seeds development
# fixture organizations, users and memberships.
CARBONFLOW_SEED_DEMO_DATA=false

# --- Java backend: evidence vault ------------------------------------------
# Filesystem location for the private evidence vault. File bytes live here;
# metadata and tenant-owned links live in PostgreSQL.
CARBONFLOW_EVIDENCE_VAULT_DIR=

# --- React frontend ---------------------------------------------------------
# Base URL of the Java API. Leave empty to call same-origin relative
# /api/v1/... paths (reverse-proxy deployments). For direct dev-server access
# to the Java backend, set http://localhost:8080.
VITE_JAVA_API_BASE_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# Removed in Phase 10.5 (Node/Express era) - no longer read by anything:
#   GEMINI_API_KEY      Java uses a deterministic in-process analytics engine;
#                       no external LLM is involved.
#   JWT_SECRET          superseded by CARBONFLOW_JWT_SECRET
#   REFRESH_TOKEN_SECRET superseded by CARBONFLOW_REFRESH_TOKEN_SECRET
#   DATABASE_URL        superseded by DB_HOST / DB_PORT / DB_NAME
#   STORAGE_DRIVER      superseded by CARBONFLOW_EVIDENCE_VAULT_DIR
#   SUPABASE_URL        superseded by CARBONFLOW_EVIDENCE_VAULT_DIR
#   SUPABASE_SERVICE_ROLE_KEY  superseded by CARBONFLOW_EVIDENCE_VAULT_DIR
#   SUPABASE_STORAGE_BUCKET    superseded by CARBONFLOW_EVIDENCE_VAULT_DIR
#   APP_URL             self-referential links were a Node-era concern
# ---------------------------------------------------------------------------
